# API — PostgreSQL connection string. Never commit a real password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/faultlens
PORT=3001

# Request policy
REQUEST_BODY_LIMIT=256kb
HTTP_REQUEST_TIMEOUT_MS=65000
CORS_ORIGINS=http://localhost:3000

# Single-instance in-memory fixed-window rate limiting.
# Use a shared Redis-backed limiter behind multiple API instances.
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
GENERATION_RATE_LIMIT_MAX=20
GENERATION_RATE_LIMIT_WINDOW_MS=60000

# PostgreSQL pool/timeout policy
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=2000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=5000
PG_HEALTH_TIMEOUT_MS=1000

# Dependency readiness check
OLLAMA_HEALTH_TIMEOUT_MS=2000

# Authentication — generate a random secret of at least 32 characters.
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=

# API — local Ollama endpoint (Phase 3+).
OLLAMA_BASE_URL=http://localhost:11434

# Next.js server-side proxy to the NestJS API.
# For local development use localhost; in deployment use the private/internal API URL.
FAULTLENS_API_URL=http://localhost:3001
